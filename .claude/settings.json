      "Bash(sqlcmd -S localhost -d dbOPT *)",
      "Bash(npx tsc *)",
      "Bash(grep -n \"selected\\\\|template literal\\\\|\\\\\\\\\\\\\\\\\\\\\\\\$\" \"C:/Users/alexi/.claude/projects/c--Adrovez-GitHub-OPT/memory/feedback_patterns.md\")",
      "Bash(Get-ChildItem -Path \"c:\\\\Adrovez\\\\GitHub\\\\OPT\\\\src\\\\basedatos\" -Filter \"*027*\")",
      "Bash(Select-Object -First 5)",
      "Bash(npm run *)",
      "Bash(Get-ChildItem -Path \"C:\\\\Adrovez\\\\GitHub\\\\OPT\\\\src\\\\backend\" -Recurse -Filter \"OPTDbContext.cs\")",
